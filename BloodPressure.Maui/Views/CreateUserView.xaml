<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BloodPressure.Maui.Views.CreateUserView"
             Title="CreateUserView">
    <VerticalStackLayout>
        <Label FontSize="Large">Crear cuenta owo</Label>
        <Label>Nombre Usuario</Label>
        <Entry Text="{Binding UsuarioRegistar.Username}"></Entry>
        <Label>Contraseña</Label>
        <Entry IsPassword="True" Text="{Binding UsuarioRegistar.Password}"></Entry>

        <Label>Confirmar contraseña</Label>
        <Entry IsPassword="True" Text="{Binding UsuarioRegistar.ConfirmPassword}"></Entry>

        <Label TextColor="Red" Text="{Binding Error}" FontSize="Small" ></Label>

        <HorizontalStackLayout>
        <Button Command="{Binding RegisterCommand}" Text="Crear cuenta"></Button>
        <Button Command="{Binding CancelCommand}" Text="cancelar"></Button>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>